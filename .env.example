# Optional. When set, the narrative report (FR-2), delegation suggestions
# (FR-13), and drafted emails/reminders (FR-14) are generated by the Gemini
# API. When unset, each falls back to a deterministic, template-based
# generator built from the fixture data — the app is fully functional and
# demoable without this key.
GEMINI_API_KEY=

# Optional. A Microsoft Teams "Incoming Webhook" URL. When unset (or
# unreachable), "Send to Teams" fails gracefully: logged server-side and
# surfaced as a non-blocking toast — it never crashes the app.
TEAMS_WEBHOOK_URL=
